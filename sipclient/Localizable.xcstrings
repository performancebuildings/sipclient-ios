    },
    "There's nothing to log in to here. Open the invite link from your administrator." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier gibt es nichts, bei dem Sie sich anmelden können. Öffnen Sie den Einladungslink Ihres Administrators."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’y a rien ici auquel vous connecter. Ouvrez le lien d’invitation de votre administrateur."
          }
        }
      }
    },
    "This app uses the open source software listed here. Tap an entry to read its licence." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App verwendet die hier aufgeführte Open-Source-Software. Tippen Sie auf einen Eintrag, um seine Lizenz zu lesen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette app utilise les logiciels open source listés ici. Touchez une entrée pour lire sa licence."
          }
        }
      }
    },
    "This invite link isn't valid" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Einladungslink ist ungültig"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce lien d’invitation n’est pas valide"
          }
        }
      }
    },
    "This phone may still receive calls. Connect to the internet and log in again to fix this." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Telefon erhält möglicherweise weiterhin Anrufe. Stellen Sie eine Internetverbindung her und melden Sie sich erneut an, um das zu beheben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce téléphone peut encore recevoir des appels. Connectez-vous à Internet et reconnectez-vous à votre compte pour corriger cela."
          }
        }
      }
    },
    "Try again" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erneut versuchen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réessayer"
