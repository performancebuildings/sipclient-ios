    },
    "An admin may have changed this extension." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möglicherweise hat ein Admin diese Nebenstelle geändert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un administrateur a peut-être modifié ce poste."
          }
        }
      }
    },
    "An admin may have changed this extension. If not, too many contacts may be registered; try again in 5 minutes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möglicherweise hat ein Admin diese Nebenstelle geändert. Falls nicht, sind eventuell zu viele Kontakte registriert. Versuchen Sie es in 5 Minuten noch einmal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un administrateur a peut-être modifié ce poste. Sinon, trop de contacts sont peut-être enregistrés ; réessayez dans 5 minutes."
          }
        }
      }
    },
