        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente de la vidéo…"
          }
        }
      }
    },
    "You'll be logged out of %@ and stop receiving its door calls on this phone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie werden von %@ abgemeldet und erhalten auf diesem Telefon keine Türanrufe mehr von dort."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous serez déconnecté de %@ et ne recevrez plus ses appels de porte sur ce téléphone."
          }
        }
      }
    },
    "You'll stop receiving door calls on this phone" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie erhalten auf diesem Telefon keine Türanrufe mehr"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne recevrez plus d’appels de porte sur ce téléphone"
          }
        }
      }
    },
    "Your account isn't set up for door calls yet. Ask an admin to provision it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Konto ist noch nicht für Türanrufe eingerichtet. Bitten Sie einen Admin, es einzurichten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte n’est pas encore configuré pour les appels de porte. Demandez à un administrateur de le configurer."
          }
        }
      }
