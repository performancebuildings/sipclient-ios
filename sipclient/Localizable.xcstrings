{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ didn't accept your login. Ask your administrator." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat Ihre Anmeldung nicht akzeptiert. Wenden Sie sich an Ihren Administrator."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’a pas accepté votre connexion. Contactez votre administrateur."
          }
        }
      }
    },
    "%@, retrying" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, neuer Versuch läuft"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, nouvelle tentative en cours"
          }
        }
      }
    },
